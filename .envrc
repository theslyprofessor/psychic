# Devbox integration
if command -v devbox &> /dev/null; then
  eval "$(devbox generate direnv --print-envrc)"
fi

# Allow users to override runtime (npm, pnpm, yarn, bun)
export RUNTIME="${RUNTIME:-npm}"

# PostgreSQL environment
export PGDATA="${PWD}/.devbox/postgres"
export PGHOST="${PGDATA}"

# Node environment
export NODE_ENV="${NODE_ENV:-development}"

echo "✅ Loaded Psychic dev environment (Runtime: ${RUNTIME})"
