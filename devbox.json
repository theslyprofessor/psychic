{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/main/.schema/devbox.schema.json",
  "packages": [
    "nodejs_22",
    "postgresql@16",
    "bun@latest",
    "wrk@latest",
    "hey@latest"
  ],
  "shell": {
    "init_hook": [
      "echo '══════════════════════════════════════════════════════════'",
      "echo '  Psychic Framework - Development Environment'",
      "echo '══════════════════════════════════════════════════════════'",
      "echo ''",
      "echo '  Node: '$(node --version)'  Bun: '$(bun --version)",
      "echo ''",
      "echo '  Commands:'",
      "echo '    devbox run dev              - Start dev server (Express)'",
      "echo '    devbox run dev:hono         - Start dev server (Hono)'",
      "echo '    devbox run test             - Run tests'",
      "echo '    devbox run bench:express    - Benchmark Express'",
      "echo '    devbox run bench:hono       - Benchmark Hono'",
      "echo '    devbox run bench:compare    - Compare both frameworks'",
      "echo ''"
    ],
    "scripts": {
      "setup": "bun install",
      "test": "npx vitest run",
      "dev": "npx tsx test-adapter.ts express",
      "dev:hono": "npx tsx test-adapter.ts hono",
      "bench:express": "./scripts/bench.sh express",
      "bench:hono": "./scripts/bench.sh hono",
      "bench:compare": "./scripts/bench.sh compare",
      "db:start": "pg_ctl -D $PGDATA -l $PGDATA/logfile start",
      "db:stop": "pg_ctl -D $PGDATA stop",
      "db:init": [
        "initdb -D $PGDATA",
        "echo \"unix_socket_directories = '$PGDATA'\" >> $PGDATA/postgresql.conf",
        "pg_ctl -D $PGDATA -l $PGDATA/logfile start",
        "createdb psychic_test",
        "echo 'Database initialized: psychic_test'"
      ]
    }
  },
  "env": {
    "PGDATA": "$PWD/.devbox/postgres",
    "RUNTIME": "bun"
  }
}
